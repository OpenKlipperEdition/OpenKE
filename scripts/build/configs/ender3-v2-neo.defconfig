# STM32F103 target for the Creality Ender-3 V2 Neo (4.2.2 / 4.2.7 mainboard)
#
# 72MHz Cortex-M3 clock, 28KiB bootloader offset (0x08007000), 8MHz crystal,
# USART3 on PB11/PB10 (10-pin IDC ribbon connector), 230400 baud, SWD auto-disable.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART3=y
CONFIG_STM32F103GD_DISABLE_SWD=y
CONFIG_SERIAL_BAUD=230400
