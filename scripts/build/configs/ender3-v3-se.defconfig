# GD32F303RET6 target for the Creality Ender-3 V3 SE (CR4NS200323C13)
#
# 120MHz Cortex-M4 clock, 512KB flash, 64KB RAM, app origin 0x08007000 (28KiB offset),
# USART2 on PA2/PA3, 230400 baud, SWD auto-disable, native hx71x/load cell support.
CONFIG_MACH_STM32=y
CONFIG_MACH_GD32F303=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART2=y
CONFIG_SERIAL_BAUD=230400
