#!/bin/sh
#
# Real, persistent writable storage for this build, replacing the tmpfs
# stand-in from FIRMWARE.md sec 24 (S01tmpfs-datastore). That script was a
# deliberate, temporary safety choice for an untested custom image: /usr/data
# (mmcblk0p10) is a real ext4 partition physically shared with stock (not
# duplicated per A/B slot), so it mounted plain tmpfs over it instead, at the
# cost of losing all state - WiFi credentials, printer.cfg SAVE_CONFIG,
# display calibration - on every single reboot.
#
# Now that the kernel side is a tagged, proven production baseline
# (functional-production-baseline-2026-07-23) with working A/B fallback, this
# mounts the real partition - but everything this build writes lives under
# the single authoritative NebulaOS namespace, /usr/data/nebulaos, never
# touching whatever else already exists on that shared partition from stock.
# First-boot-only seeding (checked via existence, not reseeded every boot
# like the tmpfs version had to be) means real user state - WiFi creds,
# calibration, SAVE_CONFIG - survives reboots from here on.
#
# NebulaOS mutable-runtime closure mission (2026-07-27): DATA_ROOT used to be
# /usr/data/openke, a separate legacy path this project's own S02 namespace
# script had to migrate data OUT of. That path has been fully retired - there
# is no deployed OpenKE user base, so no migration compatibility is needed
# for any future device. This script now writes directly into
# /usr/data/nebulaos, the same authoritative root S02nebulaos-namespace/
# S05nebulaos-activate use. PDATA in particular intentionally uses the exact
# same path S05 later validates and (re-)binds - this makes S01's own bind
# mount here a genuine, always-available fallback: if S05's own validation
# ever fails (namespace missing/invalid), /opt/printer_data still ends up
# bound to this same real, writable directory rather than falling through to
# the read-only squashfs, where klippy.log/moonraker.log writes would fail
# outright. S05's bind_if_not_already() already no-ops cleanly when its
# target is already mounted, so having both scripts bind the identical
# source directory is deliberate, not a redundant double-mount.
#
# Runs after S00revert-safety, before anything that needs to read/write these
# paths - webcam/klipper/moonraker/helixscreen (S50+) all come later, and
# before S02nebulaos-namespace (this script's own mkdir -p calls below only
# ever create the specific subdirectories it needs; S02's own layout
# creation is a superset and is unaffected by running second).
#
# /usr/data itself must exist as a real (if empty) directory baked into the
# image - scripts/build/overlay/usr/data/.keep is what guarantees that. The
# root filesystem is squashfs (read-only), so mkdir -p /usr/data below can
# only ever succeed if that directory already exists on disk to mount over;
# a genuinely brand-new top-level directory can never be created here at
# runtime. Found for real: an earlier overlay cleanup pass removed the only
# file that used to live under usr/data/ in the overlay source (moved to its
# correct /opt/printer_data location), which silently stopped baking in the
# usr/data directory itself as a side effect - this whole script then failed
# every mkdir/mount/cp call in sequence, and the display service never started.

DATA_ROOT=/usr/data/nebulaos
PDATA=$DATA_ROOT/printer_data
HELIX_STATE=$DATA_ROOT/apps/helixscreen

seed_once() {
	src="$1"
	dst="$2"
	[ -e "$dst" ] && return 0
	mkdir -p "$(dirname "$dst")"
	cp -a "$src" "$dst"
}

start() {
	mkdir -p /usr/data
	mount -t ext4 /dev/mmcblk0p10 /usr/data

	mkdir -p "$DATA_ROOT"

	# Seed real defaults from the squashfs's baked-in copies, once ever -
	# a real device's SAVE_CONFIG/calibration/credentials must never be
	# clobbered by a later boot just because this script runs again.
	seed_once /opt/printer_data "$PDATA"
	mkdir -p "$HELIX_STATE/config"

	# /opt/printer_data ships baked-in defaults on the read-only squashfs
	# (printer.cfg, moonraker.conf) for the seed step above - bind-mounting
	# the real persistent copy over it is what makes Klipper/Moonraker's
	# hardcoded /opt/printer_data paths (S55klipper, S56moonraker) actually
	# writable and persistent, without changing either service's config.
	mount --bind "$PDATA" /opt/printer_data

	# The old UI hardcoded a config path on the read-only squashfs; HelixScreen
	# instead receives HELIX_CONFIG_DIR from its service.
	# No application binaries or assets are duplicated into persistent storage.
	# This keeps the immutable application bundle separate from user state.
	# HelixScreen reads its immutable assets from /opt/helixscreen and writes
	# user configuration under HELIX_CONFIG_DIR, set by S58helixscreen.

	# The previous UI separately hardcoded a printer-data helper path (a
	# stock-Creality-style absolute path, not configurable) - point it at the
	# same real printer_data tree as everything else instead of a second,
	# disconnected copy.
	#
	# CRITICAL: only create these two top-level links if nothing already
	# exists there - real incident, found live testing on this project's
	# actual test device: /usr/data (mmcblk0p10) is the SAME physical
	# partition stock uses, and this device already had a real, previously-
	# installed touchscreen application there from real prior use (themes, calibration,
	# backups, and a real touchscreen binary). `ln -sf SRC DST` treats
	# an existing DST *directory* as "create the link inside it using SRC's
	# basename" instead of replacing DST - so an old application directory
	# could not safely be replaced as a
	# symlink (it already existed as a real directory); it silently landed
	# inside it and overwrote the real touchscreen binary with a symlink to
	# a path that only exists on the custom image, breaking stock's own
	# stock application outright. The printer_data case was the same mechanism but
	# landed on a name nothing already used, so it only left a harmless
	# stray extra entry rather than destroying anything. Recovered by hand
	# from a real backup the device owner had made; both are now guarded so
	# this can never happen again on a device with real stock content on
	# this partition - if either path already has ANY content, real or
	# leftover from us, this leaves it alone rather than guessing.
	[ -e /usr/data/printer_data ] || ln -s /opt/printer_data /usr/data/printer_data
}

case "$1" in
	start)
		start
		;;
	*)
		;;
esac
exit 0
