#!/bin/sh
#
# OpenKE Config Migration CLI
#
# Migrates printer_data/config to match the current rootfs image version
# while preserving all user calibrations, SAVE_CONFIG parameters, and custom macros.

set -eu

OPENKE_ROOT="${OPENKE_ROOT:-/usr/data/openke}"
SEEDS="${SEEDS:-/opt/openke-seeds}"
LIB="/etc/openke-config-migrate.sh"

if [ ! -f "$LIB" ]; then
	LIB="/usr/libexec/openke-config-migrate.sh"
fi

if [ -f "$LIB" ]; then
	. "$LIB"
else
	echo "ERROR: migration library not found ($LIB)" >&2
	exit 1
fi

openke_migrate_config_tree "$OPENKE_ROOT" "$SEEDS"
